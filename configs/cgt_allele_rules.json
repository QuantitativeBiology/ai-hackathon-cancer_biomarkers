{
  "_comment": "CGT feature operationalisation (DESIGN v3 10.1/10.3). Read by scripts/build_cgt.py; molecular data only. Mutation rules apply to OmicsSomaticMutations default entries (IsDefaultEntryForModel == Yes). codon = first integer in ProteinChange (p.V600E -> 600; p.E746_A750del -> 746). Classes: missense (VariantType SNV/substitution and ProteinChange without del/ins/dup/fs/Ter), inframe (del/ins/dup/delins without fs), frameshift (fs), splice (VariantInfo contains splice_donor/splice_acceptor). CN = P1 cn cache (relative CN, linear). Fusions = P1 fusion cache (OmicsFusionFiltered), default entries, Gene1 = 5-prime, Gene2 = 3-prime, partner != driver, FFPM >= ffpm_min.",
  "version": "cgt-rules-1",
  "params": {
    "ffpm_min": 0.1,
    "cn_amp": 2.0,
    "cn_del": 0.25,
    "cn_loss": 0.75,
    "lofbi_af_min": 0.7,
    "sil_log2tpm_max": 1.0,
    "sil_below_lineage_median_by": 2.0,
    "sil_lineage_expressed_frac": 0.5,
    "sil_min_lineage_lines": 10,
    "hypermutated_top_frac": 0.05,
    "msi_score_threshold": 20.0,
    "er_mixture_lineages": [
      "Breast",
      "Uterus",
      "Ovary/Fallopian Tube"
    ],
    "er_mixture_posterior_cut": 0.5,
    "er_subtype_pos_tokens": [
      "ER+",
      "luminal ER+"
    ],
    "er_subtype_neg_tokens": [
      "ER-",
      "TNBC",
      "basal_A TNBC",
      "basal_B TNBC"
    ],
    "her2_subtype_pos_tokens": [
      "HER2+",
      "basal_A HER2+"
    ]
  },
