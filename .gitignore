# Raw, restricted and derived bulk data are never committed (DepMap terms, third-party licences, size).
# Committed: code, configs, small derived results tables (per-gene / per-pair summaries), documents.
data/
cache/
external/
*.parquet
*.feather
*.npy
*.npz
*.pkl
*.joblib
*.h5
*.hdf5
*.gz
*.zip
*.tar
*.xlsx
*.maf
__pycache__/
.ipynb_checkpoints/
.pytest_cache/
.venv/
*.log

# Results policy (DESIGN v2 §13.5, R1-AF5): *.gz and *.parquet above also match under results/, so committed
# results must be plain .csv/.json (<= 5 MB); bulk tables stay in cache/ with sha256 in results/bulk_manifest.csv.
